        {
          "name": "Verificar username disponible",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/check-username?username=juanp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "check-username"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "juanp"
