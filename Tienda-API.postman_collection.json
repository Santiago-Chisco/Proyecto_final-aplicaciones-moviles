            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"juanp\",\n  \"password\": \"mala\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
