              "path": [
                "api",
                "auth",
                "reset"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@correo.com\",\n  \"code\": \"{{resetCode}}\",\n  \"password\": \"nuevaclave123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
